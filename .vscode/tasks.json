{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "QEMU: mps2-an505 (gdbserver)",
            "type": "shell",
            "command": "qemu-system-arm",
            "args": [
                "-machine",
                "mps2-an505",
                "-nographic",
                "-semihosting",
                "-kernel",
                "${workspaceFolder}/tests/ir_tests/build/test_double_printf_literals.elf",
                "-s",
                "-S"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "QEMU: stop",
            "type": "shell",
            "command": "pkill",
            "args": [
                "-f",
                "qemu-system-arm -machine mps2-an505"
            ],
            "problemMatcher": []
        }
    ]
}