# Shared core headers — build configuration
# Included by the top-level Makefile.
#
# source/include/ holds the two headers that are not owned by any one module:
# tcc.h (the umbrella every TU includes) and tcctypes.h (the primitive typedefs
# tcc.h is built on).  Everything else lives with the module that implements it.

CORE_INC = -I$(TOP)/source/include

CORE_HDRS = \
	source/include/tcc.h \
	source/include/tcctypes.h
