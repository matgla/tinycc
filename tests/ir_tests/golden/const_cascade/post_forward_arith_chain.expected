0000: T0 <-- P1 AND #3
0001: Addr[StackLoc[-16]] <-- #1 STORE_INDEXED T0
0002: StackLoc[-16] <-- #5 [STORE]
0003: V0 <-- #5 [ASSIGN]
0004: V1 <-- #8 [ASSIGN]
0005: V2 <-- #16 [ASSIGN]
0006: CMP P0,#0
0007: JMP to 9  if "!="
0008: JMP to 11
0009: T6 <-- V2 [LOAD]
0010: RETURNVALUE T6
0011: RETURNVALUE #0
